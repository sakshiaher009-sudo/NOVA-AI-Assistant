# ============================================================
# NOVA — Local AI Voice Agent Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# All defaults are configured for local-only operation.

# --- Application ---
APP_NAME=NOVA
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
VERBOSE_LOGGING=false

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Ollama LLM ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Lightweight (~1.3GB): llama3.2:1b
# Balanced  (~2GB):    llama3.2:3b
# Quality   (~4.7GB):  llama3.1:8b
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# --- Speech-to-Text ---
# Model sizes: tiny (~75MB), base (~140MB), small (~460MB)
STT_MODEL=base
STT_LANGUAGE=en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- Text-to-Speech ---
# Piper voice model name (downloaded automatically)
# Set to "macos" to use macOS built-in say command
TTS_ENGINE=macos
TTS_PIPER_VOICE=en_US-lessac-medium
TTS_SPEED=1.0

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Vector Database ---
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Document Upload ---
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,txt,md,docx

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Performance ---
MAX_CONVERSATION_CONTEXT=20
MAX_RAG_RESULTS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
